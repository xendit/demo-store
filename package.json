{
  "name": "demo-store",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch -r dotenv/config server/index.ts",
    "build": "vite build && tsc -b tsconfig.server.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node -r dotenv/config dist/index.js",
    "tsc": "tsc"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xendit-components-web": "0.0.31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2"
  }
}